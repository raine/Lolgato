#!/usr/bin/env bash
set -euo pipefail

project_dir=$(git rev-parse --show-toplevel)
cd "$project_dir"

project_name="Lolgato"
install_path="/Applications/$project_name.app"
dev_mode=false
skip_notarization=false

for arg in "$@"; do
	case $arg in
	--dev)
		dev_mode=true
		;;
	--skip-notarization | --no-notarize)
		skip_notarization=true
		;;
	*)
		echo "Unknown argument: $arg" >&2
		exit 1
		;;
	esac
done

quit_running_app() {
	if pgrep -x "$project_name" >/dev/null; then
		echo "Quitting running $project_name..."
		osascript -e "tell application \"$project_name\" to quit"
		sleep 1
	fi
}

install_app() {
	local app_path=$1

	if [[ ! -d "$app_path" ]]; then
		echo "Error: app not found at $app_path" >&2
		exit 1
	fi

	echo "Installing to /Applications..."
	rm -rf "$install_path"
	cp -R "$app_path" "$install_path"
}

mkdir -p build

if [[ "$dev_mode" == true ]]; then
	echo "Building development version..."
	app_path="build/Debug/$project_name.app"
	xcodebuild build \
		-project "$project_name.xcodeproj" \
		-scheme "$project_name" \
		-configuration Debug \
		-derivedDataPath build/DerivedData \
		CONFIGURATION_BUILD_DIR="$project_dir/build/Debug" \
		-quiet
else
	echo "Building release..."
	app_path="build/$project_name.app"
	if [[ "$skip_notarization" == true ]]; then
		./scripts/archive --skip-notarization
	else
		./scripts/archive
	fi
fi

quit_running_app
install_app "$app_path"

if [[ "$dev_mode" == true ]]; then
	echo "Installed $project_name to /Applications (development)"
else
	echo "Installed $project_name to /Applications (release)"
fi
